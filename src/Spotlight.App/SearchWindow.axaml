<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Spotlight.App"
        x:Class="Spotlight.App.SearchWindow"
        Title="聚焦搜索"
        Width="880"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI, WenQuanYi Zen Hei, sans-serif">

  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="6,1" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <!-- Filter / sort chips under the search box. Not focusable, so typing stays in the box. -->
    <Style Selector="Button.chip">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.chip.on">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox#Query">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox#Query:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox#Query:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>

  <Border x:Name="Shell"
          Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          ClipToBounds="True">
    <StackPanel>
      <!-- Search box -->
      <Grid ColumnDefinitions="Auto,*" Margin="18,12,18,12">
        <Path Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center"
              Fill="{DynamicResource TextSecondary}"
              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
        <TextBox x:Name="Query" Grid.Column="1" Margin="10,0,0,0" FontSize="24"
                 Foreground="{DynamicResource TextPrimary}"
                 Watermark="聚焦搜索" VerticalContentAlignment="Center" />
      </Grid>

      <Grid x:Name="FilterBar" IsVisible="False" ColumnDefinitions="*,Auto" Margin="14,0,14,8">
        <StackPanel x:Name="KindChips" Orientation="Horizontal" Spacing="2" />
        <StackPanel x:Name="SortChips" Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <TextBlock Text="排序" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="Notice" IsVisible="False" TextWrapping="Wrap" Margin="20,0,20,10"
                 FontSize="12" Foreground="#E0A000" />

      <!-- Results + preview -->
      <Grid x:Name="ResultsArea" IsVisible="False" Height="420" ColumnDefinitions="340,1,*">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="3" Height="1" Background="{DynamicResource DividerBrush}" />

        <ListBox x:Name="Results" Grid.Row="1" Background="Transparent" Padding="0,6"
                 x:DataType="local:ResultItem">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:ResultItem">
              <Grid ColumnDefinitions="32,*" Height="40">
                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Glyph}" IsVisible="{Binding !HasIcon}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource DividerBrush}" />

        <!-- Preview of the selected item -->
        <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" Grid.Column="2" Padding="20,16" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Preview" Spacing="10">
            <!-- The page / picture itself, with the matched words marked, when the file has one. -->
            <Border x:Name="PageFrame" IsVisible="False" HorizontalAlignment="Center" Background="White"
                    BoxShadow="0 1 6 0 #40000000">
              <Panel>
                <Image x:Name="PageImage" Stretch="Fill" />
                <Canvas x:Name="HitLayer" />
              </Panel>
            </Border>
            <TextBlock x:Name="PageLabel" IsVisible="False" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" />
            <Panel x:Name="IconPanel" HorizontalAlignment="Center" Height="72" Margin="0,8,0,0">
              <Image x:Name="PreviewIcon" Width="64" Height="64" />
              <TextBlock x:Name="PreviewGlyph" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
            <SelectableTextBlock x:Name="PreviewName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                 TextAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="PreviewDetails" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6" />
            <SelectableTextBlock x:Name="PreviewSnippet" FontSize="13" TextWrapping="Wrap" LineHeight="21"
                                 Foreground="{DynamicResource TextPrimary}" />
            <SelectableTextBlock x:Name="PreviewPath" FontSize="11" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Footer -->
      <Border x:Name="Footer" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="18,7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="Status" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                     Text="↵ 打开   Ctrl+↵ 打开位置   Tab 切换类型   Ctrl+Shift+C 复制路径   Esc 关闭" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>
